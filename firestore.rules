rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'finalworld@gmail.com',
        'sanja.kropsu@gmail.com'
      ];
    }

    match /users/{userId}/{document=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
    }

    match /communityBooks/{bookId}/contributions/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
